{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd shared && npm ci && npm run build && cd ../client && npm ci",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/api/(.*)",
      "dest": "${API_URL}/api/$1",
      "env": ["API_URL"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
