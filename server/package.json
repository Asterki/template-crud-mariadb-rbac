{
  "name": "@template/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "bundle": "tsup",
    "start": "cross-env NODE_ENV=production node ./dist/index.js",
    "db:generate": "prisma generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "knip": "knip --no-exit-code"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@quixo3/prisma-session-store": "^3.1.19",
    "@template/shared": "file:../shared",
    "async-retry": "^1.3.3",
    "bcrypt": "^6.0.0",
    "chromadb": "^3.0.17",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.3.3",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "path": "^0.12.7",
    "redis": "^5.12.1",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "validator": "^13.15.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/async-retry": "^1.4.9",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/speakeasy": "^2.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "module-alias": "^2.2.3",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.10",
    "prisma": "^7.4.1",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
