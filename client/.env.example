# Browser API base URL. On Vercel keep `/api`; the rewrite proxy forwards
# it to the API_URL configured in the Vercel project.
VITE_API_URL=/api

# Brand overrides
VITE_APP_NAME=Template
VITE_APP_SLUG=template
VITE_BRAND_COLOR=#1e3976
VITE_DEFAULT_LOCALE=en

# Development only: Vite proxies /api and injects this header.
# Never prefix it with VITE_. Production uses the Vercel rewrite.
ORIGIN_SECRET=
VITE_PROXY_TARGET=http://localhost:3000
